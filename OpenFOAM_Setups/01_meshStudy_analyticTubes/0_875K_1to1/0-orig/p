FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    
    IN_FR {
        type        zeroGradient;
    }

    OUT_T {
        type            fixedValue;
        value           uniform 0;
    }

    ".*WW.*" {
        type            zeroGradient;
    }

    OUT_FR {
        type            cyclic;
        neighbourPatch  IN_MAIN;
    }

    IN_MAIN {
        type            cyclic;
        neighbourPatch  OUT_FR;
    }

    OUT_MAIN {
        type            cyclic;
        neighbourPatch  IN_T;
    }

    IN_T {
        type            cyclic;
        neighbourPatch  OUT_MAIN;
    }
}

