FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    IN_FR {
        type            fixedValue;
        value           uniform (2 0 0);
    }

    OUT_T {
        type            pressureInletOutletVelocity;
        inletValue      uniform (0 0 0);
        value           $internalField;
    }
    ".*WW.*" {
        type            noSlip;
    }

    OUT_FR {
        type            cyclic;
        neighbourPatch  IN_MAIN;
    }

    IN_MAIN {
        type            cyclic;
        neighbourPatch  OUT_FR;
    }

    OUT_MAIN {
        type            cyclic;
        neighbourPatch  IN_T;
    }

    IN_T {
        type            cyclic;
        neighbourPatch  OUT_MAIN;
    }
}

