boundingK {
    type          fieldMinMax;
    libs          (fieldFunctionObjects);
    writeControl  timeStep;
    writeFields   true;           // writes fields min/max as volScalarFields
    log           true;           // writes min/max to log
    // region        "";             // (if using regions, specify region name)
    fields        ( k );
  }
  boundingOmega {
    type          fieldMinMax;
    libs          (fieldFunctionObjects);
    writeControl  timeStep;
    writeFields   true;
    log           true;
    fields        ( omega );
  }

  limitOmegaMax
  {
    type            limitFields;
    libs            (fieldFunctionObjects);
    active          true;

    fields          (omega);
    limit           max;
    max             1E6;
  }

  limitOmegaMin
  {
    type            limitFields;
    libs            (fieldFunctionObjects);
    active          true;

    fields          (omega);
    limit           min;
    min             1E-5;
  }
}

