FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
        minIter         2;
        // cacheAgglomeration no;
        // maxIter         50;
    }

/*     pFinal
    {
        $p;
        // tolerance       1e-6;
        relTol          0;
    } */

    // "pcorr.*"
    // {
    //     $p;
    //     tolerance       1e-7;
    //     relTol          0;
    // }

    Phi
    {
        $p;
    }

    // MeshPhi
    // {
    //     solver          smoothSolver;
    //     smoother        symGaussSeidel;
    //     tolerance       1e-2;
    //     relTol          0;
    // }

    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-10;
        relTol          0;
        minIter         3;
        maxIter         100;
    }

   /*  "(U|k|omega)Final"
    {
        $U;
        relTol          0;
    } */
}

PIMPLE
{
    correctPhi          yes;
    correctMeshPhi      yes;
    nOuterCorrectors    3;
    nCorrectors         2;
    nNonOrthogonalCorrectors 2;
    residualControl
    {
        ".*"    1E-7;
    }
}

SIMPLE
{
    consistent                  yes;
    nCorrectors 2;
    nUCorrectors                1;
    nNonOrthogonalCorrectors    2;
    residualControl
    {
        ".*"    1E-7;
    }
    pRefCell    0;
    pRefValue   0;
}

potentialFlow
{
    nNonOrthogonalCorrectors 10;
    PhiRefCell      0;
    PhiRefValue     0;
}

relaxationFactors
{   
    fields
    {
        p               0.3;
    }
    equations
    {

        U               0.6;
        "(k|omega).*"   0.3;
    }
}

cache
{
    grad(U);
}

