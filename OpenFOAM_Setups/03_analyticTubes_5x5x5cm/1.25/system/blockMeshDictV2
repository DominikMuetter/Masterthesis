FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 1; // formerly "convertToMeters"

boundaryExtends
{
    xMin   -0.09;
    xMax    0.285;
    yMin    0.01;
    yMax    0.035;
    zMin    0.01;
    zMax    0.035;
}

vertices
(
    ($boundaryExtends/xMin $boundaryExtends/yMin $boundaryExtends/zMin) // 0
    ($boundaryExtends/xMax $boundaryExtends/yMin $boundaryExtends/zMin) // 1
    ($boundaryExtends/xMax $boundaryExtends/yMax $boundaryExtends/zMin) // 2
    ($boundaryExtends/xMin $boundaryExtends/yMax $boundaryExtends/zMin) // 3
    ($boundaryExtends/xMin $boundaryExtends/yMin $boundaryExtends/zMax) // 4
    ($boundaryExtends/xMax $boundaryExtends/yMin $boundaryExtends/zMax) // 5
    ($boundaryExtends/xMax $boundaryExtends/yMax $boundaryExtends/zMax) // 6
    ($boundaryExtends/xMin $boundaryExtends/yMax $boundaryExtends/zMax) // 7

);

blocks
(
    hex (0 1 2 3 4 5 6 7) (380 25 25) simpleGrading (1 1 1)
);

edges
(
);

boundary
(
    IN_X1 {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    OUT_X2 {
        type patch;
        faces
        (
            (1 5 6 2)
        );
    }
    WW_Y1 {
        type wall;
        faces
        (
            (0 4 5 1)
        );
    }
    WW_Y2 {
        type wall;
        faces
        (
            (3 2 6 7)
        );
    }
    WW_Z1 {
        type wall;
        faces
        (
            (0 3 2 1)
        );
    }
    WW_Z2 {
        type wall;
        faces
        (
            (4 7 6 5)
        );
    }
);

mergePatchPairs();
// ************************************************************************* //
