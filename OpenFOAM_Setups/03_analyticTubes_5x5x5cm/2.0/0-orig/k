FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

/* k = 3/2 * (U * I)^2 = 9.3750e-04 [m^2 / s^2]
    k : turbulent kinetic energy [m^2 / s^2]
    U : Velocity, 0.25 [m/s],
    I : turbulence intensity.
        0.01 - 0.05 --> low turbulence (e.g. freestream)
        0.05 - 0.1  --> internal flows                      <-- we assume 0.05
        0.1  - 0.2  --> behind grids
*/

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.001; //0.0009375;  // estimated manually

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    
    IN_X1 {
        type        fixedValue;
        value       $internalField;
    }

    OUT_X2 {
        // type        zeroGradient;
        type        inletOutlet;
        inletValue  $internalField;
        value       $internalField;
    }

    "WW_(Y1|Y2|Z1|Z2)" {
        type        kqRWallFunction;
        value       $internalField;
    }

    "MAIN_WW_(Y1|Y2|Z1|Z2)" {
        type        kqRWallFunction;
        value       $internalField;
    }

    surface {
        type        kqRWallFunction;
        value       $internalField;
    }

    "(OUT_FORERUNNING|IN_MAIN|OUT_MAIN|IN_TAILING)" {
        type        inletOutlet;
        inletValue  $internalField;
        value       $internalField;
    }
}

