FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

/* omega = ( k^0.5 ) / ( C_mu^0.25 * l ) [1/s]
    k = 9.3750e-04 [m^2 / s^2]          turbulent kinetic energy
    l = 0.07 * 0.025 = 0.00175 [m]      turbulence length scale
    C_mu = 0.09                         model constant
*/
dimensions      [0 0 -1 0 0 0 0];


internalField   uniform 100;//32.0; // 31.94382824999699566546 estimated by hand

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    IN_X1 {
        /* type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.00175;
        value           $internalField; */
        type        fixedValue;
        value       $internalField;
    }

    OUT_X2 {
        type        inletOutlet;
        inletValue  $internalField;
        value       $internalField;
        // type            zeroGradient;
    }

    "WW_(Y1|Y2|Z1|Z2)" {
        type        omegaWallFunction;
        value       $internalField;
    }

    "MAIN_WW_(Y1|Y2|Z1|Z2)" {
        type        omegaWallFunction;
        value       $internalField;
    }

    surface {
        type        omegaWallFunction;
        value       $internalField;
    }

    "(OUT_FORERUNNING|IN_MAIN|OUT_MAIN|IN_TAILING)" {
        // type        zeroGradient;
        type        inletOutlet;
        inletValue  $internalField;
    }
}

