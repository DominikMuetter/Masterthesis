FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale 1; // formerly "convertToMeters"

forerunnings
{
    xMin   -0.115;
    xMax   -0.0205;
    yMin   -0.0125;
    yMax    0.0125;
    zMin   -0.0125;
    zMax    0.0125;
}

mainBlock
{
    xMin   -0.0205;
    xMax    0.015;
    yMin   -0.0125;
    yMax    0.0125;
    zMin   -0.0125;
    zMax    0.0125;
}

tailings
{
    xMin    0.015;
    xMax    0.26;
    yMin   -0.0125;
    yMax    0.0125;
    zMin   -0.0125;
    zMax    0.0125;
}

nCells
{
    yz           25;
    mainBlock    40;
    forerunningX 95;
    tailingsX    245;
}


vertices
(
    // main block
    ($mainBlock/xMin $mainBlock/yMin $mainBlock/zMin) // 0
    ($mainBlock/xMax $mainBlock/yMin $mainBlock/zMin) // 1
    ($mainBlock/xMax $mainBlock/yMax $mainBlock/zMin) // 2
    ($mainBlock/xMin $mainBlock/yMax $mainBlock/zMin) // 3
    ($mainBlock/xMin $mainBlock/yMin $mainBlock/zMax) // 4
    ($mainBlock/xMax $mainBlock/yMin $mainBlock/zMax) // 5
    ($mainBlock/xMax $mainBlock/yMax $mainBlock/zMax) // 6
    ($mainBlock/xMin $mainBlock/yMax $mainBlock/zMax) // 7

    // forerunnings
    ($forerunnings/xMin $forerunnings/yMin $forerunnings/zMin) // 8
    ($forerunnings/xMax $forerunnings/yMin $forerunnings/zMin) // 9
    ($forerunnings/xMax $forerunnings/yMax $forerunnings/zMin) // 10
    ($forerunnings/xMin $forerunnings/yMax $forerunnings/zMin) // 11
    ($forerunnings/xMin $forerunnings/yMin $forerunnings/zMax) // 12
    ($forerunnings/xMax $forerunnings/yMin $forerunnings/zMax) // 13
    ($forerunnings/xMax $forerunnings/yMax $forerunnings/zMax) // 14
    ($forerunnings/xMin $forerunnings/yMax $forerunnings/zMax) // 15
    
    // tailings
    ($tailings/xMin $tailings/yMin $tailings/zMin) // 16
    ($tailings/xMax $tailings/yMin $tailings/zMin) // 17
    ($tailings/xMax $tailings/yMax $tailings/zMin) // 18
    ($tailings/xMin $tailings/yMax $tailings/zMin) // 19
    ($tailings/xMin $tailings/yMin $tailings/zMax) // 20
    ($tailings/xMax $tailings/yMin $tailings/zMax) // 21
    ($tailings/xMax $tailings/yMax $tailings/zMax) // 22
    ($tailings/xMin $tailings/yMax $tailings/zMax) // 23

);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($nCells/mainBlock $nCells/yz $nCells/yz) simpleGrading (1 1 1)       // main block
    // hex (0 1 2 3 4 5 6 7) ($nCells/mainX $nCells/yz $nCells/yz) simpleGrading (1 1 1)       // main block
    hex (8 9 10 11 12 13 14 15) ($nCells/forerunningX $nCells/yz $nCells/yz) simpleGrading (1 1 1)   // forerunnings
    hex (16 17 18 19 20 21 22 23) ($nCells/tailingsX $nCells/yz $nCells/yz) simpleGrading (1 1 1) // tailings
);

edges
(
);

boundary
(
    // patch pairs connecting the blocks
    OUT_FORERUNNING {
        type patch;
        faces
        (
            // (0 4 7 3)
            (9 10 14 13)
        );
    }
    IN_MAIN {
        type patch;
        faces
        (
            (0 4 7 3)
            // (9 10 14 13)
        );
    }

    OUT_MAIN {
        type patch;
        faces
        (
            (1 5 6 2)
            // (16 20 23 19)
        );
    }
    IN_TAILING {
        type patch;
        faces
        (
            // (1 5 6 2)
            (16 20 23 19)
        );
    }

    // main block defined separately, because we don't want boundary layers here (would be broken due to geometry inside). Instead the cell size of the main block equals the cell size of the boundary layers on the other patches
    MAIN_WW_Y1 {
        type wall;
        faces
        (
            (0 4 5 1)
        );
    }
    MAIN_WW_Y2 {
        type wall;
        faces
        (
            (3 2 6 7)
        );
    }
    MAIN_WW_Z1 {
        type wall;
        faces
        (
            (0 3 2 1)
        );
    }
    MAIN_WW_Z2 {
        type wall;
        faces
        (
            (4 7 6 5)
        );
    }

    // inflow patch on forerunning
    IN_X1 {
        type patch;
        faces
        (
            (8 12 15 11)
        );
    }
    // outflow patch on tailing
    OUT_X2 {
        type patch;
        faces
        (
            (17 21 22 18)
        );
    }
    // walls on forerunning and tailing. Separately defined to enable selective boundary layer creation
    WW_Y1 {
        type wall;
        faces
        (
            (8 9 13 12)
            (16 17 21 20)
        );
    }
    WW_Y2 {
        type wall;
        faces
        (
            (11 15 14 10)
            (19 18 22 23)
        );
    }
    WW_Z1 {
        type wall;
        faces
        (
            (8 11 10 9)
            (16 19 18 17)
        );
    }
    WW_Z2 {
        type wall;
        faces
        (
            (12 13 14 15)
            (20 21 22 23)
        );
    }
    
);

// needed to connect the patches between the blocks
mergePatchPairs();
