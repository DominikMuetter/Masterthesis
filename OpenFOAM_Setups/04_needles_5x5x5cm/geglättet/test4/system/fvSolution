FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
        minIter         2;
        maxIter         300;
        cacheAgglomeration yes;
    }

    pFinal
    {
        $p;
        // tolerance       1e-6;
        relTol          0;
    }

    "pcorr.*"
    {
        $p;
        tolerance       1e-7;
        relTol          0;
    }

    Phi
    {
        $p;
    }

    // MeshPhi
    // {
    //     solver          smoothSolver;
    //     smoother        symGaussSeidel;
    //     tolerance       1e-2;
    //     relTol          0;
    // }

    "(U|k|omega)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-9;
        relTol          0.1;
        minIter         3;
        maxIter         300;
    }

    "(U|k|omega)Final"
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    correctPhi          yes;
    correctMeshPhi      yes;
    nOuterCorrectors    3;
    nCorrectors         2;
    nNonOrthogonalCorrectors 2;
}

SIMPLE
{
    consistent                  yes;
    nCorrectors                 2;
    nUCorrectors                1;
    nNonOrthogonalCorrectors    2;
    residualControl
    {
        ".*"    1E-8;
        p       1E-9;
    }
    pRefCell    0;
    pRefValue   0;
}

potentialFlow
{
    nNonOrthogonalCorrectors 20;
    PhiRefCell      0;
    PhiRefValue     0;
}

relaxationFactors
{   
    fields
    {
        p               0.7;
    }
    equations
    {

        U               0.7;
        "(k|omega).*" 0.7;
    }
}

cache
{
    grad(U);
    grad(k);
    grad(omega);
}

