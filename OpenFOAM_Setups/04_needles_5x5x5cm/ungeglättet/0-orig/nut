FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    
    IN_X1 {
        type    calculated;
        value   $internalField;
    }

    OUT_X2 {
        type    calculated;
        value   $internalField;
        // type    zeroGradient;
    }
    
    "WW_(Y1|Y2|Z1|Z2)" {
        type    nutkWallFunction;
        // type    nutUBlendedWallFunction;
        value   $internalField;
    }

    "MAIN_WW_(Y1|Y2|Z1|Z2)" {
        type    nutkWallFunction;
        // type    nutUBlendedWallFunction;
        value   $internalField;
    }

    surface {
        type    nutkWallFunction;
        // type    nutUBlendedWallFunction;
        value   $internalField;
    }

    "(OUT_FORERUNNING|IN_MAIN|OUT_MAIN|IN_TAILING)" {
        type    calculated;
        value   $internalField;
    }
}

