FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.018;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"
    
    IN_MAIN {
        type        fixedValue;
        value       $internalField;
    }

    OUT_MAIN {
        // type        zeroGradient;
        type        inletOutlet;
        inletValue  $internalField;
        value       $internalField;
    }

    ".*WW.*" {
        type        kqRWallFunction;
        value       $internalField;
    }

    surface {
        type        kqRWallFunction;
        value       $internalField;
    }
}

