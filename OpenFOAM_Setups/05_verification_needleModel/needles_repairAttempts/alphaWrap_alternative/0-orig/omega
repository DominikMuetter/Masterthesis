FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [0 0 -1 0 0 0 0];


internalField   uniform 12.8;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    IN_MAIN {
        type        fixedValue;
        value       $internalField;
    }

    OUT_MAIN {
        type        inletOutlet;
        inletValue  $internalField;
        value       $internalField;
    }

    ".*WW.*" {
        type        omegaWallFunction;
        value       $internalField;
    }
    surface {
        type        omegaWallFunction;
        value       $internalField;
    }
}

