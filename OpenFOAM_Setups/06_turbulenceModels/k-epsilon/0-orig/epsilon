FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -3 0 0 0 0];


internalField   uniform 1.0346e-01; //estimated by hand

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    IN_FR {
        type        fixedValue;
        value       $internalField;
    }

    OUT_T {
        type        inletOutlet;
        inletValue  $internalField;
        value       $internalField;
    }

    ".*WW.*" {
        type        epsilonWallFunction;
        value       $internalField;
    }

    surface {
        type        epsilonWallFunction;
        value       $internalField;
    }

    OUT_FR {
        type            cyclic;
        neighbourPatch  IN_MAIN;
    }

    IN_MAIN {
        type            cyclic;
        neighbourPatch  OUT_FR;
    }

    OUT_MAIN {
        type            cyclic;
        neighbourPatch  IN_T;
    }

    IN_T {
        type            cyclic;
        neighbourPatch  OUT_MAIN;
    }
}

