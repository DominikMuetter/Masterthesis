FoamFile
{
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
        minIter         2;
        maxIter         300;
        cacheAgglomeration yes;
    }

    pFinal
    {
        $p;
        relTol          0;
    }

    "pcorr.*"
    {
        $p;
        tolerance       1e-7;
        relTol          0;
    }

    Phi
    {
        $p;
    }

    "(U|k|epsilon)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.1;
        minIter         3;
        maxIter         300;
    }

    "(U|k|epsilon)Final"
    {
        $U;
        relTol          0;
    }
}

SIMPLE
{
    consistent                  yes;
    nCorrectors                 2;
    nUCorrectors                1;
    nNonOrthogonalCorrectors    2;
    residualControl
    {
        ".*"    1E-7;
        p       1E-9;
    }
    pRefCell    0;
    pRefValue   0;
}

potentialFlow
{
    nNonOrthogonalCorrectors 10;
    PhiRefCell      0;
    PhiRefValue     0;
}

relaxationFactors
{   
    fields
    {
        p               0.7;
    }
    equations
    {

        U               0.7;
        "(k|epsilon).*"   0.7;
    }
}

cache
{
    grad(U);
    grad(k);
    grad(epsilon);
}

